# Nusxa olib ".env" deb saqlang. Lokal (restoran) rejimida bu fayl shart emas.
MODE=local            # local — restoran kompyuteri, cloud — internetdagi server
PORT=8080
# HOST=0.0.0.0        # cloud rejimda 127.0.0.1 (faqat Caddy orqali)
# DATA_DIR=./data
# PLATFORM_PASSWORD=  # platforma paneli paroli
# RATE_LIMIT=600      # bitta IP dan daqiqasiga so'rov
# TRUST_PROXY=1       # proksi (Caddy/nginx) ortida bo'lsa

# --- 6-etap: mijoz ilovasi va onlayn to'lov (faqat cloud) ---
# SMS_MODE=test       # test — kod ekranda (sinov). Haqiqiy SMS provayder ulangach o'zgaradi
# PAYME_MERCHANT_ID=
# PAYME_KEY=          # Payme kabinetidagi kalit (test yoki haqiqiy)
# PAYME_TEST=1        # 1 — checkout.test.paycom.uz
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=

# --- 10-etap: ishga chiqarish (batafsil: docs/LAUNCH.md) ---
# SMS_MODE=eskiz            # haqiqiy SMS (Eskiz.uz); kabinetda "FastHub tasdiqlash kodi: {kod}" shablonini tasdiqlating
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546            # jo'natuvchi nomi (Eskiz bergan)
# PUSH_MODE=fcm             # push xabarlar
# FCM_SERVICE_ACCOUNT=/opt/dasturxon/firebase.json
# ALERT_TG_TOKEN=           # server xatolari, zaxira va holat ogohlantirishlari shu botga
# ALERT_TG_CHAT=
# BACKUP_REMOTE=uzbackup:fasthub   # rclone manzili (O'zbekistondagi ikkinchi server, sftp)
# BACKUP_PASSPHRASE=        # zaxira shifrlash paroli — alohida joyda saqlang!
# BACKUP_KEEP_DAYS=30
# REVIEW_PHONE=998901234567 # Google Play / App Store tekshiruvchisi uchun demo raqam (SMS ketmaydi)
# REVIEW_CODE=12345
