{
  "appId": "uz.fasthub.app",
  "appName": "FastHub Uz",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0f1714"
  },
  "ios": {
    "backgroundColor": "#0f1714",
    "contentInset": "always"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
